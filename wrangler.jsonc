// Cloudflare Workers settings: serve this repo as the website (static files, no build step).
// worker.js only runs for paths that aren't files in the repo, i.e. the Patreon login at /api/patreon/*.
{
  "name": "anglefantasyprojections",
  "compatibility_date": "2025-09-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "keep_vars": true
}
